        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Delivery"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Demo disabled or scope denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Invalid lifecycle or OTP state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Demo rate limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Confirm"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateDelivery": {
        "type": "object",
        "properties": {
          "merchant_id": {
            "type": "string",
            "format": "uuid"
          },
          "recipient_name": {
            "type": "string",
            "maxLength": 120
          },
          "recipient_phone": {
            "type": "string",
            "maxLength": 30
          },
          "destination_postcode": {
            "type": "string"
          },
          "parcel_description": {
            "type": "string",
            "maxLength": 1000
          },
          "delivery_instructions": {
            "type": "string",
            "maxLength": 1000
          },
          "external_reference": {
            "type": "string",
            "maxLength": 120,
            "nullable": true
          }
        },
        "required": [
          "merchant_id",
          "recipient_name",
          "recipient_phone",
          "destination_postcode"
        ]
      },
      "Assign": {
        "type": "object",
        "properties": {
          "rider_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "rider_id"
        ]
      },
      "Progress": {
        "type": "object",
        "properties": {
          "rider_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "picked_up",
              "out_for_delivery",
              "failed"
            ]
          }
        },
        "required": [
          "rider_id",
          "status"
        ]
      },
      "Confirm": {
        "type": "object",
        "properties": {
          "rider_id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          }
        },
        "required": [
          "rider_id",
          "code"
        ]
      },
      "Rider": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "phone"
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "DeliveryCreated": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "merchant_id": {
            "type": "string",
            "format": "uuid"
          },
          "address_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Delivery": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "merchant_id": {
            "type": "string",
            "format": "uuid"
          },
          "address_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "rider_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "recipient_name": {
            "type": "string"
          },
          "recipient_phone": {
            "type": "string"
          },
          "parcel_description": {
            "type": "string",
            "nullable": true
          },
          "delivery_instructions": {
            "type": "string",
            "nullable": true
          },
          "postcode": {
            "type": "string"
          },
          "formatted_address": {
            "type": "string"
          },
          "rider_name": {
            "type": "string",
            "nullable": true
          },
          "proof_confirmed": {
            "type": "boolean"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "delivery_id": {
            "type": "string",
            "format": "uuid"
          },
          "event_type": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "metadata": {
            "type": "object"
          }
        }
      },
      "RiderResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "merchant_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "active_deliveries": {
            "type": "integer"
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "postcode": {
            "type": "string"
          },
          "formatted_address": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "mock"
            ]
          },
          "provider_data": {
            "type": "object",
            "properties": {
              "mock": {
                "type": "boolean"
              },
              "verified": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "Stats": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "pending": {
            "type": "integer"
          },
          "active": {
            "type": "integer"
          },
          "completed": {
            "type": "integer"
          },
          "failed": {
            "type": "integer"
          }
        }
      },
      "Demo": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "demo"
            ]
          },
          "provider": {
            "type": "string",
            "enum": [
              "mock"
            ]
          },
          "merchant": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "postcodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "OTP": {
        "type": "object",
        "properties": {
          "demo_otp": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "expires_in_seconds": {
            "type": "integer",
            "enum": [
              300
            ]
          },
          "warning": {
            "type": "string"
          }
        }
      }
    }
  }
}
