          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Demo disabled or scope denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Invalid lifecycle or OTP state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Demo rate limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/deliveries/{id}/confirm": {
      "post": {
        "summary": "Confirm delivery using OTP",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Delivery"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Demo disabled or scope denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Invalid lifecycle or OTP state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Demo rate limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Confirm"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/addresses/autocomplete": {
      "get": {
        "summary": "Server-side NIPOST autocomplete proxy; shares a 60 requests/minute per-instance postcode budget",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "At most ten suggestions for the active segment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Autocomplete"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query: 2\u201330 ASCII letters/digits/spaces/hyphens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Search scope denied or demo operations disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Local postcode budget or upstream rate limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Upstream unavailable or malformed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "API key rejected or credits unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Upstream timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateDelivery": {
        "type": "object",
        "properties": {
          "merchant_id": {
            "type": "string",
            "format": "uuid"
          },
          "recipient_name": {
            "type": "string",
            "maxLength": 120
          },
          "recipient_phone": {
            "type": "string",
            "maxLength": 30
          },
          "destination_postcode": {
            "type": "string"
          },
          "parcel_description": {
            "type": "string",
            "maxLength": 1000
          },
          "delivery_instructions": {
            "type": "string",
            "maxLength": 1000
          },
          "external_reference": {
            "type": "string",
            "maxLength": 120,
            "nullable": true
          },
          "customer_address": {
            "type": "string",
            "minLength": 5,
            "maxLength": 1000,
            "description": "Customer-provided full street address. Required in NIPOST mode; never NIPOST-verified."
          },
          "landmark": {
            "type": "string",
            "maxLength": 500,
            "description": "Customer-provided landmark or delivery directions."
          }
        },
        "required": [
          "merchant_id",
          "recipient_name",
          "recipient_phone",
          "destination_postcode"
        ]
      },
      "Assign": {
        "type": "object",
        "properties": {
          "rider_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "rider_id"
        ]
      },
      "Progress": {
        "type": "object",
        "properties": {
          "rider_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "picked_up",
              "out_for_delivery",
              "failed"
            ]
          }
        },
        "required": [
          "rider_id",
          "status"
        ]
      },
      "Confirm": {
        "type": "object",
        "properties": {
          "rider_id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          }
        },
        "required": [
          "rider_id",
          "code"
        ]
      },
      "Rider": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "phone"
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Machine-readable error category. NIPOST 401/402 map to 503; scope denial 403; rate limit 429; timeout 504; unavailable/malformed 502."
          }
        }
      },
      "DeliveryCreated": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "merchant_id": {
            "type": "string",
            "format": "uuid"
          },
          "address_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Delivery": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "merchant_id": {
            "type": "string",
            "format": "uuid"
          },
          "address_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "rider_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "recipient_name": {
            "type": "string"
          },
          "recipient_phone": {
            "type": "string"
          },
          "parcel_description": {
            "type": "string",
            "nullable": true
          },
          "delivery_instructions": {
            "type": "string",
            "nullable": true
          },
          "postcode": {
            "type": "string"
          },
          "formatted_address": {
            "type": "string"
          },
          "rider_name": {
            "type": "string",
            "nullable": true
          },
          "proof_confirmed": {
            "type": "boolean"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "customer_address": {
            "type": "string",
            "nullable": true
          },
          "landmark": {
            "type": "string",
            "nullable": true
          },
          "address_source": {
            "type": "string",
            "enum": [
              "customer",
              "offline_demo"
            ]
          },
          "postcode_provider": {
            "type": "string",
            "enum": [
              "mock",
              "nipost"
            ]
          },
          "postcode_verified": {
            "type": "boolean"
          },
          "postcode_verified_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "postcode_environment": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "delivery_id": {
            "type": "string",
            "format": "uuid"
          },
          "event_type": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "metadata": {
            "type": "object"
          }
        }
      },
      "RiderResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "merchant_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "active_deliveries": {
            "type": "integer"
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "postcode": {
            "type": "string"
          },
          "formatted_address": {
            "type": "string",
            "nullable": true
          },
          "provider": {
            "type": "string",
            "enum": [
              "mock",
              "nipost"
            ]
          },
          "provider_data": {
            "type": "object",
            "properties": {
              "verified": {
                "type": "boolean",
                "description": "True only for successful NIPOST L1 validity verification; does not verify street address"
              },
              "lookup_level": {
                "type": "integer",
                "enum": [
                  1
                ]
              },
              "environment": {
                "type": "string",
                "enum": [
                  "sandbox",
                  "production",
                  "unknown"
                ]
              },
              "mock": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "Stats": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "pending": {
            "type": "integer"
          },
          "active": {
            "type": "integer"
          },
          "completed": {
            "type": "integer"
          },
          "failed": {
            "type": "integer"
          }
        }
      },
      "Demo": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "demo"
            ]
          },
          "provider": {
            "type": "string",
            "enum": [
              "mock",
              "nipost"
            ]
          },
          "merchant": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "postcodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "environment": {
            "type": "string",
            "enum": [
              "offline",
              "sandbox",
              "production",
              "unknown"
            ]
          },
          "customer_address_required": {
            "type": "boolean"
          },
          "lookup_level": {
            "type": "integer",
            "nullable": true,
            "enum": [
              1
            ]
          }
        }
      },
      "OTP": {
        "type": "object",
        "properties": {
          "demo_otp": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "expires_in_seconds": {
            "type": "integer",
            "enum": [
              300
            ]
          },
          "warning": {
            "type": "string"
          }
        }
      },
      "Autocomplete": {
        "type": "object",
        "properties": {
          "segment": {
            "type": "string",
            "enum": [
              "state",
              "lga",
              "district",
              "area",
              "unit"
            ]
          },
          "suggestions": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
